# ========================================
# EWS RETENTION PLATFORM - ENVIRONMENT CONFIGURATION
# ========================================
# Copy this file to .env and update values for your environment.
# All variables are documented with type, default, and valid values.

# -----------------------------------------------------------------------------
# --- Database -------------------------------------------------------------
# -----------------------------------------------------------------------------

# SQLAlchemy database connection string
# Type: string
# Default: sqlite:///./backend/data/sql_app.db
# Examples: sqlite:///./data.db, postgresql://user:pass@localhost/ews
DATABASE_URL=sqlite:///./backend/data/sql_app.db

# -----------------------------------------------------------------------------
# --- Server -------------------------------------------------------------
# -----------------------------------------------------------------------------

# FastAPI server bind host
# Type: string
# Default: 0.0.0.0
API_HOST=0.0.0.0

# FastAPI server bind port
# Type: integer
# Default: 8000
API_PORT=8000

# Comma-separated list of allowed CORS origins
# Type: string
# Default: http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# --- Auth / Security -------------------------------------------------------------
# -----------------------------------------------------------------------------

# REQUIRED. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-generated-secret-key-here

# Application environment
# Type: string
# Values: development, production
# Default: development
# In production, weak SECRET_KEY values cause startup failure
ENVIRONMENT=development

# JWT token expiration time
# Type: integer (minutes)
# Default: 60
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Rate limiting (SlowAPI)
# Type: string (format: "count/peroid", e.g., "5/minute", "10/hour")
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_INGEST=10/hour
RATE_LIMIT_DEFAULT=200/minute

# Maximum upload file size for ingestion (MB)
# Type: integer
# Default: 50
MAX_UPLOAD_SIZE_MB=50

# Hash of the integration API key for HMAC-SHA256 request signing.
# Generate with: python -c "import hashlib; print(hashlib.sha256(b'YOUR_RAW_KEY_HERE').hexdigest())"
# Store only the hash here, never the raw key.
INTEGRATION_API_KEY_HASH=

# -----------------------------------------------------------------------------
# --- Ingestion -------------------------------------------------------------
# -----------------------------------------------------------------------------

# Primary engagement data filename (in backend/data/)
# Type: string
# Default: Engagement_Analysis.xlsx
ENGAGEMENT_DATA_FILE=Engagement_Analysis.xlsx

# Quiz/exam attendance workbook filename
# Type: string
# Default: _Trimester-1 2025 Attendance Quiz-Assignment-Exam 5Jan2025.xlsx
QUIZ_EXAM_DATA_FILE=_Trimester-1 2025 Attendance Quiz-Assignment-Exam 5Jan2025.xlsx

# Week 1-2 engagement snapshot filename (optional)
# Type: string
# Default: Week 1-2 Student Engagement Analysis.xlsx
WEEK12_ENGAGEMENT_FILE=Week 1-2 Student Engagement Analysis.xlsx

# Graded Quiz Status (9 Feb) filename (optional)
# Type: string
# Default: Graded Quiz 1 Status 9 Feb.xlsx
QUIZ_STATUS_9FEB_FILE=Graded Quiz 1 Status 9 Feb.xlsx

# Graded Quiz 10 Feb original filename (optional)
# Type: string
# Default: graded quiz 1 10 feb complete.xlsx
GRADED_QUIZ_10FEB_ORIG_FILE=graded quiz 1 10 feb complete.xlsx

# Graded Quiz 10 Feb 11:15 AM filename (optional)
# Type: string
# Default: graded quiz 1 10 feb 11 15 AM.xlsx
GRADED_QUIZ_10FEB_1115AM_FILE=graded quiz 1 10 feb 11 15 AM.xlsx

# Graded Quiz 10 Feb 4:51 PM filename (optional)
# Type: string
# Default: graded quiz 1 10 feb 4 51 PM.xlsx
GRADED_QUIZ_10FEB_451PM_FILE=graded quiz 1 10 feb 4 51 PM.xlsx

# Week 3 usage filename (optional)
# Type: string
# Default: Learner usage week 3.xlsx
WEEK3_USAGE_FILE=Learner usage week 3.xlsx

# Week 5 usage filename (optional)
# Type: string
# Default: Learner usage week 5.xlsx
WEEK5_USAGE_FILE=Learner usage week 5.xlsx

# -----------------------------------------------------------------------------
# --- Risk Scoring Thresholds -------------------------------------------------------------
# -----------------------------------------------------------------------------

# Risk level categorization thresholds (0-100 scale)
# Type: float
# RISK_THRESHOLD_LOW: below this = minimal risk monitoring
# RISK_THRESHOLD_MEDIUM: below this = low risk
# RISK_THRESHOLD_HIGH: at/above this = high risk (urgent intervention)

RISK_THRESHOLD_LOW=20.0
RISK_THRESHOLD_MEDIUM=40.0
RISK_THRESHOLD_HIGH=70.0

# Intervention decision thresholds (0-100 scale, B-4/B-5 fixes)
# These define the threshold ladder for intervention routing

# Below this: No action (default 30.0)
THRESHOLD_NO_ACTION=30.0

# 30-40: Gentle reminder (automated email) (default 40.0)
THRESHOLD_GENTLE=40.0

# 40-60: Mentor outreach (faculty) (default 60.0)
THRESHOLD_MENTOR=60.0

# 60-80: Escalated mentor outreach (default 80.0)
# 80+: Urgent intervention (sales + incentives)
THRESHOLD_URGENT=80.0

# Minimum days between interventions for same student
# Type: integer
# Default: 7
INTERVENTION_COOLDOWN_DAYS=7

# Risk score change (points) that triggers even during cooldown (B-5 fix)
# Type: float
# Default: 15.0 (was incorrectly 0.15 in previous versions)
# Scale: 0-100 (matches risk_score scale)
RISK_SPIKE_THRESHOLD=15.0

# --- Risk Scoring ---
# Weight of calendar-aware risk component (0.0-1.0, remainder goes to feature-based score)
CALENDAR_RISK_BLEND_WEIGHT=0.4
# Type of scoring model: "rule_based" (current) or "xgboost" (future, requires trained model)
DEFAULT_MODEL_TYPE=rule_based

# -----------------------------------------------------------------------------
# --- Calendar and Semester -------------------------------------------------------------
# -----------------------------------------------------------------------------

# ISO date of trimester week 1 day 1
TRIMESTER_START_DATE=2026-01-05
# Human-readable semester name for display and snapshot labeling
CURRENT_SEMESTER_NAME=Trimester 2

# -----------------------------------------------------------------------------
# --- Feature Weights -------------------------------------------------------------
# -----------------------------------------------------------------------------

# Model type — ONLY "rule_based" is valid currently (M-2 fix)
# Type: string
# Values: rule_based (xgboost reserved for future V2)
# Default: rule_based
DEFAULT_MODEL_TYPE=rule_based

# Feature weights for risk scoring formula (M-3 fix: consolidated dict)
# All weights should sum to approximately 1.0
# Type: float (each)
# Range: 0.0 to 1.0

# Core engagement features
WEIGHT_CONTENT_COMPLETION=0.30
WEIGHT_LOGIN_CONSISTENCY=0.20
WEIGHT_QUIZ_ENGAGEMENT=0.20
WEIGHT_ASSIGNMENT=0.15
WEIGHT_TIME_INVESTMENT=0.08
WEIGHT_DISCUSSION=0.02

# Self-directed learning (risk reducer — E-5 enhancement)
# Weight for self-directed learning signal in risk score (sum of all weights must = 1.0)
WEIGHT_SELF_DIRECTED_LEARNING=0.05

# -----------------------------------------------------------------------------
# --- Background Jobs -------------------------------------------------------------
# -----------------------------------------------------------------------------

# Hour for daily prediction generation (UTC)
# Type: integer (0-23)
# Default: 3 (3:00 AM UTC)
SCHEDULER_DAILY_HOUR=3

# Day for weekly tasks (0=Monday, 6=Sunday)
# Type: integer (0-6)
# Default: 6
SCHEDULER_WEEKLY_DAY=6

# -----------------------------------------------------------------------------
# --- LLM / AI (Optional) -------------------------------------------------------------
# -----------------------------------------------------------------------------

# LLM provider selection
# Type: string
# Values: gemini, claude
# Default: gemini
LLM_PROVIDER=gemini

# Google Gemini API key (optional)
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model name
# Default: gemini-1.5-pro
GEMINI_MODEL=gemini-1.5-pro

# Anthropic Claude API key (optional)
CLAUDE_API_KEY=your-claude-api-key-here

# Claude model name
# Default: claude-3-5-sonnet-20241022
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# LLM generation parameters
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

# -----------------------------------------------------------------------------
# --- Cache (Optional) -------------------------------------------------------------
# -----------------------------------------------------------------------------

# Redis connection URL (optional — falls back gracefully if unavailable)
# Type: string
# Default: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Cache expiration time (seconds)
# Type: integer
# Default: 300 (5 minutes)
CACHE_EXPIRE_SECONDS=300

# -----------------------------------------------------------------------------
# --- Business Metrics -------------------------------------------------------------
# -----------------------------------------------------------------------------

# Average lifetime value per student (INR or USD)
# Type: float
# Default: 150000.0
AVERAGE_STUDENT_LTV=150000.0

# Tuition per semester
# Type: float
# Default: 75000.0
TUITION_PER_SEMESTER=75000.0

# Average cost per student intervention
# Type: float
# Default: 500.0
INTERVENTION_COST_PER_STUDENT=500.0

# Target retention rate (0-1 scale)
# Type: float
# Default: 0.90
TARGET_RETENTION_RATE=0.90

# -----------------------------------------------------------------------------
# --- Logging -------------------------------------------------------------
# -----------------------------------------------------------------------------

# Logging level
# Type: string
# Values: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
LOG_LEVEL=INFO

# Log file path
# Type: string
# Default: backend/backend.log
LOG_FILE=backend/backend.log

# -----------------------------------------------------------------------------
# --- Frontend (React) -------------------------------------------------------------
# -----------------------------------------------------------------------------

# Backend API URL for React frontend
# Type: string
# Default: http://localhost:8000/api/v1
REACT_APP_API_URL=http://localhost:8000/api/v1
