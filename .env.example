# ========================================
# EWS RETENTION PLATFORM - ENVIRONMENT CONFIGURATION
# ========================================
# Copy this file to .env and update values for your environment

# ========================================
# LLM CONFIGURATION
# ========================================
# Gemini API Key for AI features (recommendations, explanations, advisor)
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-pro
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024

# ========================================
# DATABASE CONFIGURATION
# ========================================
DATABASE_URL=sqlite:///./backend/data/sql_app.db

# ========================================
# API CONFIGURATION
# ========================================
API_HOST=0.0.0.0
API_PORT=8000

# Additional CORS origins (comma-separated)
# CORS_ORIGINS=https://your-frontend-domain.com

# ========================================
# ML MODEL CONFIGURATION
# ========================================
MODEL_TYPE=xgboost
MODEL_VERSION=v1.0

# Risk thresholds for UI categorization (0-1 scale)
RISK_THRESHOLD_HIGH=0.7
RISK_THRESHOLD_MEDIUM=0.4
RISK_THRESHOLD_LOW=0.0

# ========================================
# INTERVENTION DECISION THRESHOLDS
# ========================================
# These thresholds determine which intervention action is triggered
# All values are probabilities in [0.0, 1.0] range

# < 30%: No intervention needed
THRESHOLD_NO_ACTION=0.30

# 30-60%: Automated email reminder
THRESHOLD_GENTLE=0.60

# 60-80%: Faculty mentor outreach
THRESHOLD_MENTOR=0.80

# >= 80%: Urgent sales intervention
THRESHOLD_URGENT=0.80

# Minimum days between interventions per student
INTERVENTION_COOLDOWN_DAYS=7

# Risk change that triggers intervention even during cooldown
RISK_SPIKE_THRESHOLD=0.15

# ========================================
# SIGNAL WEIGHTS FOR RISK CALCULATION
# ========================================
# These weights determine contribution of each signal to final risk score
# Must sum to 1.0

WEIGHT_ACADEMIC=0.30
WEIGHT_ENGAGEMENT=0.25
WEIGHT_CONSISTENCY=0.20
WEIGHT_INTENT=0.15
WEIGHT_RESPONSIVENESS=0.10

# ========================================
# BUSINESS METRICS CONFIGURATION
# ========================================
# Average lifetime value per student (USD)
AVERAGE_STUDENT_LTV=12500.0

# Tuition per semester (USD)
TUITION_PER_SEMESTER=6250.0

# Average cost per intervention (USD)
INTERVENTION_COST=350.0

# Target retention rate (0-1 scale)
TARGET_RETENTION_RATE=0.95

# ========================================
# SCHEDULER CONFIGURATION
# ========================================
SCHEDULER_ENABLED=true

# Interval for updating predictions (seconds)
PREDICTION_UPDATE_INTERVAL=3600

# ========================================
# LOGGING
# ========================================
LOG_LEVEL=INFO
